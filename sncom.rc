#include <windows.h>
#include "src\version.h"

1 ICON "assets\\sncom.ico"
1 24 "sncom.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SNCOM_VERSION_FILE
 PRODUCTVERSION SNCOM_VERSION_FILE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "SNCom"
      VALUE "FileDescription", "SNCom 串口/网络数据调试器"
      VALUE "FileVersion", SNCOM_VERSION_STR4
      VALUE "InternalName", "sncom"
      VALUE "LegalCopyright", "Copyright (C) 2026 CoderNotCutie"
      VALUE "OriginalFilename", "sncom.exe"
      VALUE "ProductName", "SNCom"
      VALUE "ProductVersion", SNCOM_VERSION_STR4
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
